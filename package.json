{
	"name": "@lunch-money/lunch-money-js-v2",
	"version": "2.11.1",
	"type": "module",
	"description": "TypeScript client library for Lunch Money API v2",
	"main": "dist/index.cjs",
	"module": "dist/index.esm.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.esm.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"build": "rollup -c",
		"dev": "rollup -c -w",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src tests --ext .ts",
		"lint:fix": "eslint src tests --ext .ts --fix",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
		"generate-types": "openapi-typescript node_modules/@lunch-money/v2-api-spec/lunch-money-api-v2.yaml -o src/types.generated.ts --default-non-nullable false",
		"prepare": "npm run generate-types && npm run build",
		"release:verify": "npm run lint && npm run typecheck && npm run build && npm test",
		"release:dry-run": "npm run release:verify && npm publish --dry-run --access public",
		"release:publish": "npm run release:verify && npm publish --access public",
		"test": "npm run test:typecheck && node --import tsx --test tests/*.test.ts",
		"test:typecheck": "tsc -p tsconfig.tests.json"
	},
	"keywords": [
		"lunch-money",
		"api",
		"typescript",
		"openapi",
		"finance"
	],
	"author": "Lunch Money",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lunch-money/lunch-money-js-v2.git"
	},
	"bugs": {
		"url": "https://github.com/lunch-money/lunch-money-js-v2/issues"
	},
	"homepage": "https://github.com/lunch-money/lunch-money-js-v2#readme",
	"dependencies": {
		"openapi-fetch": "^0.15.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@lunch-money/v2-api-spec": "2.11.1",
		"@rollup/plugin-commonjs": "^28.0.6",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@rollup/plugin-typescript": "^12.1.4",
		"@types/node": "^18.19.130",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"openapi-typescript": "^7.9.1",
		"prettier": "^3.0.0",
		"rollup": "^4.52.2",
		"rollup-plugin-dts": "^6.2.3",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.2"
	}
}
